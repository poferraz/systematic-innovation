.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.superpowers/
dist/
benchmark/runs/
# Local session checkpoints used to resume unfinished evaluation runs.
evals/**/progress/
**/.runner.lock
benchmark/private/
benchmark/restricted/
restricted/
*.restricted.*
*.sealed.yaml
*.validation.yaml
systematic-innovation-session.bundle

# Ensure repository authority/authoring modules and synthetic isolation test fixtures are never masked
!*authority*
!*authoring*
!tests/repository/fixtures/
!tests/repository/fixtures/**
!tests/repository/fixtures/leaking-tree/
!tests/repository/fixtures/leaking-tree/restricted/
!tests/repository/fixtures/leaking-tree/restricted/validation.yaml

sources/

# Environment & Secret files
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.cert
credentials.json
secrets/



# Reviewed Task 9 source/tests override broad host token-name exclusions.
!benchmark/task9/tokens.py
!benchmark/tests/test_task9_tokens.py
