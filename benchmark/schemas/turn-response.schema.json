      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "turn_index": {
      "minimum": 2,
      "multipleOf": 2,
      "title": "Turn Index",
      "type": "integer"
    },
    "content": {
      "title": "Content",
      "type": "string"
    },
    "status": {
      "default": "succeeded",
      "enum": [
        "succeeded",
        "failed",
        "refused",
        "budget-stopped"
      ],
      "title": "Status",
      "type": "string"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Input Tokens"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "cost": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cost"
    },
    "latency_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Seconds"
    },
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "raw_response": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Response"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
